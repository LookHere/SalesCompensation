# To help sales workers visualize their achievment, we can use a gauge chart.  
# The light grey line is under the target, the dark grey is over the target, and the white is over exceptional


library(plotly)

WorkerGaugeChart <- Workers |>
  filter(WorkerID == 10001)


GaugeChart <- plot_ly(
  domain = list(x = c(0, 1), y = c(0, 1)),
value = WorkerGaugeChart$SalesEarned[1],
  title = list(text = "Quota Achievement"),
  type = "indicator",
  mode = "gauge+number+delta",
  delta = list(reference = WorkerGaugeChart$SalesEarned[1] - 250000),
  gauge = list(
    axis =list(range = list(NULL, 3000000)),
    steps = list(
      list(range = c(0, WorkerGaugeChart$QuotaTarget[1] ), color = "lightgray"),
      list(range = c(WorkerGaugeChart$QuotaTarget[1], WorkerGaugeChart$QuotaExceptional[1]), color = "gray")),
    threshold = list(
      line = list(color = "red", width = 4),
      thickness = 0.75,
      value = WorkerGaugeChart$SalesEarned[1])))
GaugeChart <- GaugeChart %>%
  layout(margin = list(l=20,r=30))

